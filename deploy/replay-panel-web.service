[Unit]
Description=Replay Panel web
After=network-online.target replay-panel-supervisor.service
[Service]
User=replay-panel
Group=replay-panel
WorkingDirectory=/opt/replay-panel/artifacts/web
Environment=REPLAY_PANEL_RUNTIME=/var/lib/replay-panel/run
Environment=REPLAY_PANEL_CONFIG=/var/lib/replay-panel/panel.json
ExecStart=/opt/replay-panel/artifacts/web/Web
Restart=on-failure
UMask=0077
TimeoutStopSec=45
[Install]
WantedBy=multi-user.target
