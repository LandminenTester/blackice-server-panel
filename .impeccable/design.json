      "css": ".ds-panel{background:var(--surface,#19171e);border:1px solid var(--line,#834653)}.ds-panel h2{margin:0;padding:20px 24px;border-bottom:1px solid var(--line,#834653);color:var(--red,#ff6477);font:500 20px 'IBM Plex Sans',sans-serif}.ds-panel textarea{display:block;width:100%;min-height:160px;padding:24px;border:0;resize:none;background:#0c1016;color:var(--cyan,#74e7e9);font:13px/1.8 'IBM Plex Mono',monospace}.ds-panel textarea:focus-visible{outline:2px solid var(--cyan,#74e7e9);outline-offset:4px}"
